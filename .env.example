# ---------------------------------------------------------------------------
# Personal AI Agent - environment configuration
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=prod
LOG_LEVEL=INFO

# --- HTTP API (bound to localhost only in docker-compose) ------------------
API_HOST=0.0.0.0
API_PORT=8080
# Long random string. Required for every /api/* call (X-API-Token header).
# Generate: openssl rand -hex 32
API_TOKEN=change-me-to-a-long-random-string

# --- Database ---------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=agent
DATABASE_URL=postgresql+asyncpg://agent:change-me-too@postgres:5432/agent

# --- Telegram (primary interface) ------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma separated numeric Telegram user IDs allowed to control the agent.
TELEGRAM_ALLOWED_USER_IDS=
# Optional: chat id used for system notifications (defaults to the first allowed user).
TELEGRAM_OWNER_CHAT_ID=

# ===========================================================================
# LLM PROVIDERS
# Configure any combination. Switch live from Telegram:
#   /models            list everything
#   /provider claude   switch to Claude
#   /provider chatgpt  switch to ChatGPT
#   /provider local    switch to the local Ollama model
#   /model gpt-4o      change model on the active provider
# ===========================================================================

# Which provider starts active: omniroute | ollama | openai | anthropic | echo
# omniroute needs NO API key: it is the default when you have no keys of your own.
LLM_PROVIDER=omniroute
LLM_TIMEOUT_S=300
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# If the active provider fails, automatically try the other configured ones.
LLM_FALLBACK_ENABLED=true

# --- Local model (Ollama) ---------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# --- ChatGPT (OpenAI) -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Claude (Anthropic) -----------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OmniRoute gateway (default, no key required) --------------------------
# Self-hosted MIT gateway that fans out to many providers incl. free tiers.
# Dashboard (add provider accounts/keys there): http://127.0.0.1:20128
OMNIROUTE_ENABLED=true
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_PORT=20128
OMNIROUTE_MEMORY_MB=2048

# --- Any other OpenAI-compatible endpoint ----------------------------------
# (OpenRouter, Groq, DeepSeek, Together, xAI, vLLM, LM Studio, llama.cpp server)
CUSTOM_LLM_NAME=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# ===========================================================================
# MESSAGING INTEGRATIONS (Go bridges)
# ===========================================================================

# Shared secret between the agent and both bridges. Generate: openssl rand -hex 32
BRIDGE_TOKEN=

# --- WhatsApp (whatsmeow, links your own account like WhatsApp Web) ---------
WHATSAPP_ENABLED=false
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:8081
# Save incoming photos/documents into /data/downloads/whatsapp
WA_DOWNLOAD_MEDIA=true

# --- Microsoft Teams (official Graph API, application permissions) ---------
TEAMS_ENABLED=false
TEAMS_BRIDGE_URL=http://teams-bridge:8082
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Default chat id or teamId/channelId used when a tool omits the target.
TEAMS_DEFAULT_CHAT=

# --- Inbound message handling ----------------------------------------------
# false = incoming messages are stored and forwarded to you on Telegram.
# true  = the agent AUTOMATICALLY creates a task for allowlisted senders.
INBOUND_AUTO_TASK=false
# Comma separated phone numbers / emails allowed to trigger tasks.
# EMPTY MEANS NOBODY. Use * only if you understand the risk.
INBOUND_ALLOWED_SENDERS=
BRIDGE_TIMEOUT_S=120

# --- Workspace --------------------------------------------------------------
WORKSPACE_DIR=/data
MAX_FILE_MB=45

# --- Engine / workers -------------------------------------------------------
MAX_TASK_STEPS=14
TASK_TIMEOUT_S=3600
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_S=2
SCHEDULER_POLL_INTERVAL_S=10
MAX_TASK_RETRIES=2

# --- Safety -----------------------------------------------------------------
REQUIRE_APPROVAL_HIGH_RISK=true
SHELL_ALLOWLIST=ls,pwd,cat,head,tail,wc,grep,find,df,du,file,sha256sum,stat,python,python3,git
ENABLE_BROWSER_TOOLS=false
ENABLE_PYTHON_TOOL=true
ENABLE_SHELL_TOOL=true
